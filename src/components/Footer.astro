---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Chao Zhang. All rights reserved.
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	@media (max-width: 720px) {
		footer {
			padding: 1.5em 1em 2.5em 1em;
			font-size: 0.9em;
		}
	}
</style>
