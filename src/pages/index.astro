---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroImage from '../assets/poppy.jpeg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-image {
				width: 100%;
				margin-bottom: 1.5em;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
      <h5>README.md</h5>
			<p>
      Random and unfiltered thoughts, mostly math but maybe occasionally
      dog pictures. Probably wrote on my train rides from NYC to Boston.
			</p>
			<div class="hero-image">
				<Image width={1020} height={510} src={HeroImage} alt="" />
      </div>
		</main>
		<Footer />
	</body>
</html>
