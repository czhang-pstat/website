---
import { Image } from 'astro:assets';
import Headshot from '../assets/headshot.jpeg';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="My short bio"
	pubDate={new Date('May 4 2026')}
>
  <Image class="headshot" src={Headshot} width={160} height={160} alt="Headshot of Chao Zhang" />
  <p>
  Math/stats/machine learning enthusiast; Bloomberg Quant; Yeshiva University Math Adjunct Prof.
  Weekends rotate between tennis, hiking, golf, biking, and restaurant adventures.
  My goldendoodle Poppy handles the rest--mostly by demanding walks and snacks.
	</p>

</Layout>

<style>
	.headshot {
		display: block;
		width: 160px;
		height: 160px;
		margin: 0 auto 1.5em;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: var(--box-shadow);
	}
</style>
