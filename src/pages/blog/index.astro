---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Plain-text preview from the start of the post body: cut at the first
// heading, then strip MDX/markdown/math syntax and truncate at a word.
function excerpt(body: string = '', maxLen = 320): string {
	let text = body.replace(/^import .*$/gm, '');
	const headingIdx = text.search(/^#{1,6}\s/m);
	if (headingIdx > 0) text = text.slice(0, headingIdx);
	text = text
		.replace(/```[\s\S]*?```/g, ' ')
		.replace(/\$\$([\s\S]*?)\$\$/g, ' ')
		.replace(/\$([^$\n]+)\$/g, '$1')
		.replace(/\[@[^\]]*\]/g, '')
		.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
		.replace(/<[^>]+>/g, ' ')
		.replace(/[*_`#>]/g, '')
		.replace(/\s+/g, ' ')
		.replace(/ ([.,;:!?])/g, '$1')
		.trim();
	if (text.length > maxLen) {
		text = text.slice(0, maxLen).replace(/\s+\S*$/, '') + ' ...';
	}
	return text;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 840px;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.card {
				display: block;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 2rem 2.5rem 1.75rem;
				text-decoration: none;
				transition: 0.2s ease;
				background: #fff;
			}
			.card:hover {
				box-shadow: 0 2px 12px rgba(var(--gray), 25%);
			}
			.date {
				margin: 0 0 0.25rem;
				text-align: center;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.title {
				margin: 0 0 1rem;
				text-align: center;
				font-size: 1.953em;
				line-height: 1.2;
				color: rgb(var(--black));
				transition: 0.2s ease;
			}
			.card:hover .title {
				color: var(--accent);
			}
			.preview {
				margin: 0 0 1.5rem;
				color: rgb(var(--gray-dark));
			}
			.read-more {
				display: flex;
				justify-content: center;
			}
			.read-more span {
				display: inline-block;
				padding: 0.35em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.85em;
				color: rgb(var(--gray));
				transition: 0.2s ease;
			}
			.card:hover .read-more span {
				border-color: var(--accent);
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.card {
					padding: 1.5rem 1.25rem 1.25rem;
				}
				.title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a class="card" href={withBase(`/blog/${post.id}/`)}>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="title">{post.data.title}</h2>
									<p class="preview">{excerpt(post.body)}</p>
									<p class="read-more">
										<span>Read more</span>
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
